// Hello world, Tinoc style. C interop is declared directly (extern "C"
// fn) or via #importc "stdio.h" — see samples/05 and samples/06.

extern "C" fn printf(fmt *const char, ...) i32;

// Main function
fn main() void 
{
    var name str = "Prathmesh";
    const lang = "Tinoc";
    // This comment should be ignored    
    printf("%s is creator of %s Programming Language!\n", name, lang);
}
