// Tagged-union enums: variants carry payloads, and switch arms bind the
// payload fields by name (Shape.Rect(w, h) gives you w and h directly).

enum Shape {
	Circle(f32),
	Rect(f32, f32),
	Point,
}

extern "C" fn printf(fmt *const char, ...) i32;

fn describe(s Shape) void {
	switch s {
		Shape.Rect(w, h) => {
			printf("rect: %.0f x %.0f (area %.0f)\n", w, h, w * h);
		}
		Shape.Circle(r) => {
			printf("circle: radius %.0f (area %.1f)\n", r, 3.0 * r * r);
		}
		Shape.Point => {
			printf("point: no area\n");
		}
	}
}

fn main() void {
	describe(Shape.Circle(2.5));
	describe(Shape.Rect(4.0, 5.0));
	describe(Shape.Point);
}
