// Types tour: arrays, multidimensional arrays, sentinel-terminated
// arrays, optionals, pointers, and a generic struct instantiation.
// (std.collections vec/map types arrive with the standard library.)

extern "C" fn printf(fmt *const char, ...) i32;

// generic struct type
struct Pair:T {
	first T;
	second T;
}

fn main() void {
	// arrays
	const message = ['h', 'e', 'l', 'l', 'o'];
	const alt_message [5]u8 = ['h', 'e', 'l', 'l', 'o'];

	// multidimensional array
	const mat [2][2]f32 = [
		[1.0, 0.0],
		[0.0, 1.0],
	];

	// sentinel-terminated array
	const sentinel [_:0]u8 = [1, 2, 3, 4];

	// optional type
	var maybe ?i32 = null;
	maybe = 42;

	// pointer type
	var x i32 = 5;
	var ptr ^i32 = &x;
	ptr^ = 10;

	// generic struct-literal instantiation
	var pair Pair:i32 = Pair:i32 { .first = 10, .second = 20 };

	printf("pair.first=%d pair.second=%d\n", pair.first, pair.second);
}
