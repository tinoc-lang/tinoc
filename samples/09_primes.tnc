// Prime counting — while loops, early returns, and bool-returning
// functions in Tinoc.
//
// isPrime uses a while loop with an early return for divisors; main()
// counts and prints every prime up to 100. Demonstrates the bool type,
// comparison operators, compound assignment (+=), and calling C printf
// through a hand-declared extern "C" fn.

extern "C" fn printf(fmt *const char, ...) i32;

fn isPrime(n i32) bool {
	if n < 2 {
		return false;
	}
	var d i32 = 2;
	while d * d <= n {
		if n % d == 0 {
			return false;
		}
		d += 1;
	}
	return true;
}

fn main() void {
	var count i32 = 0;
	for 2..101 |n| {
		if isPrime(n) {
			printf("%d ", n);
			count += 1;
		}
	}
	printf("\nfound %d primes up to 100\n", count);
}
